-- Создание таблиц базы SALES (s.bat DATA\create_tables)
-- Структура полностью соответствует сценариям create_* из архива Данные.zip
\set ON_ERROR_STOP on

DROP TABLE IF EXISTS ПРОДАЖА, ПОСТАВКА, РАБОТА, КЛИЕНТ, СОТРУДНИК,
                     МАГАЗИН, ТОВАР, ПОСТАВЩИК, КАТЕГОРИЯ, РАЙОН;

CREATE TABLE РАЙОН (
  код		int NOT NULL PRIMARY KEY,	-- код района
  название	varchar(40) NULL		-- название района
);

CREATE TABLE КАТЕГОРИЯ (
  код		int PRIMARY KEY,	-- код категории
  наименование	varchar(20) NULL	-- наименование/название категории
);

CREATE TABLE ПОСТАВЩИК (
  код		int NOT NULL PRIMARY KEY,	-- код поставщика
  название	varchar(40) NULL,		-- название организации / ЧП
  район		int NULL			-- район размещения организации
);

CREATE TABLE ТОВАР (
  код		int PRIMARY KEY,	-- код товара
  наименование	varchar(20) NULL,	-- наименование/название
  цена1		decimal(12,4) NULL,	-- (оптовая) цена приобретения (затраты на 1 ед.) [ден.ед.]
  цена2		decimal(12,4) NULL,	-- (розничная) цена реализации (выручка за 1 ед.) [ден.ед.]
  категория	int NULL,		-- тип товара - код из КАТЕГОРИЯ
  поставщик	int NULL,		-- код поставщика - из ПОСТАВЩИК
  хранение	decimal(12,4) NULL	-- стоимость хранения за 1 день 1 ед. товара [ден.ед.]
);

CREATE TABLE МАГАЗИН (
  код		int NOT NULL PRIMARY KEY,	-- код магазина/торговой точки
  название	varchar(20) NULL		-- название магазина
);

CREATE TABLE СОТРУДНИК (
  код	int NOT NULL PRIMARY KEY,	-- код сотрудника/менеджера
  имя	varchar(20) NULL		-- имя сотрудника/менеджера
);

CREATE TABLE КЛИЕНТ (
  код		int NOT NULL PRIMARY KEY,	-- код покупателя
  фамилия	varchar(20) NULL,		-- ФИО1
  имя		varchar(20) NULL,		-- ФИО2
  отчество	varchar(20) NULL,		-- ФИО3
  пол		bit NULL,			-- пол: 0 - м, 1 - ж
  дата_рожд	date NULL,			-- дата рождения
  район		int NULL			-- код района из РАЙОН
);

CREATE TABLE РАБОТА (
  сотрудник 	int NULL,	-- код сотрудника/менеджера из СОТРУДНИК
  дата1 	timestamp NULL,	-- дата начала работы в магазине
  дата2 	timestamp NULL,	-- дата последнего дня работы в магазине
  магазин	int NULL,	-- код магазина из МАГАЗИН
  старший 	bit NULL	-- 1 - старший менеджер, 0 - рядовой
);

CREATE TABLE ПОСТАВКА (
  дата 		date NOT NULL,	-- дата поставки
  товар 	int NULL,	-- код товара
  количество 	int NULL	-- количество единиц товара
);

CREATE TABLE ПРОДАЖА (
  дата		timestamp NULL,	-- дата продажи
  магазин	int NOT NULL,	-- код магазина, где выполнена продажа
  товар 	int NULL,	-- код проданного товара
  количество 	int NULL,	-- количество ед. проданного товара
  клиент 	int NULL	-- код покупателя
);

\dt
